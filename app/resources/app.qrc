<RCC>
    <qresource prefix="/">
        <file alias="style.qss">style.qss</file>
    </qresource>

    <qresource prefix="/icons">
        <!--
            首页入口图标按 86x86 显示，这里统一用预缩放的 172x172（2 倍）资源。
            原来直接用 1254x1254 原图（单张 1.1~1.4MB），Qt 每次构造首页都要
            解码并以大比例缩小，是启动耗时的主要来源。
        -->
        <file alias="music.png">icons/small_music.png</file>
        <file alias="video.png">icons/small_video.png</file>
        <file alias="diagnostic.png">icons/small_diagnostic.png</file>
        <file alias="sentinel.png">icons/small_sentinel.png</file>
        <file alias="reverse.png">icons/small_reverse.png</file>
        <file alias="camera.png">icons/small_photo.png</file>
    </qresource>

    <qresource prefix="/video">
        <file alias="play.png">icons/btn_play1.png</file>
        <file alias="pause.png">icons/btn_pause1.png</file>
        <file alias="next.png">icons/btn_next1.png</file>
        <file alias="volume-down.png">icons/btn_volumedown1.png</file>
        <file alias="volume-up.png">icons/btn_volumeup1.png</file>
        <file alias="fullscreen.png">icons/btn_fullscreen1.png</file>
        <file alias="windowed.png">icons/btn_fullscreen2.png</file>
    </qresource>
</RCC>
